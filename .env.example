# Dummy local values only. Replace locally; never commit real credentials.
RMS_DB_URL=jdbc:mysql://localhost:3307/rms?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
# Managed TLS database URL example only (replace placeholders; do not use host values literally):
# RMS_DB_URL=jdbc:mysql://HOST:PORT/DBNAME?sslMode=REQUIRED&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
RMS_DB_USER=rms_app
RMS_DB_PASSWORD=replace-with-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-local-mysql-root-password
RMS_JWT_SECRET=replace-with-at-least-32-byte-local-secret
RMS_SUPERADMIN_EMAIL=superadmin@example.test
RMS_SUPERADMIN_NAME=Local Super Admin
RMS_SUPERADMIN_PASSWORD=Replace123
RMS_TIMEZONE=Asia/Kolkata
RMS_CORS_ALLOWED_ORIGINS=http://localhost:5173
RMS_TRUST_PROXY=false
RMS_TRUSTED_PROXY_HOPS=1
RMS_DB_POOL_MAX=5
# Rate limits default to the documented production values. Raise only for local E2E runs.
RMS_RATE_LIMIT_LOGIN_MAX=5
RMS_RATE_LIMIT_REGISTER_MAX=10
RMS_RATE_LIMIT_CONTACT_MAX=5
